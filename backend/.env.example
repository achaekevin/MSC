# ==============================================================================
# MWANCHA SENIOR COMMUNITY (MSC) - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: Never commit production credentials, secrets, or real database passwords.
# Duplicate this file to .env and provide your private infrastructure values.

NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Connection (MySQL / MariaDB / Aiven MySQL)
DATABASE_URL="mysql://db_user:db_password@localhost:3306/mwancha_community"

# JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET="replace_with_a_cryptographically_secure_random_access_secret_32chars"
JWT_REFRESH_SECRET="replace_with_a_cryptographically_secure_random_refresh_secret_32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Application Origin
FRONTEND_URL="http://localhost:5173"
STAGING_FRONTEND_URL="https://staging.mwanchasenior.org"
COOKIE_DOMAIN="localhost"

# Cloudinary Media Storage (Optional: defaults to local demo if not configured)
CLOUDINARY_CLOUD_NAME="demo_cloud"
CLOUDINARY_API_KEY="123456789"
CLOUDINARY_API_SECRET="secret"

# Transactional Email Provider (Resend or SMTP)
RESEND_API_KEY=""
EMAIL_FROM="Mwancha Senior Community <notifications@mwanchasenior.org>"
ADMIN_NOTIFICATION_EMAIL="mwachahomeforelderly@gmail.com"

# Optional SMTP Settings (alternative to Resend)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# API Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Initial Admin Bootstrap Credentials
INITIAL_ADMIN_EMAIL="admin@mwanchasenior.com"
INITIAL_ADMIN_PASSWORD="ReplaceWithStrongInitialPassword123!"
INITIAL_ADMIN_NAME="MSC System Administrator"
ADMIN_INVITE_CODE="REPLACE_WITH_SECURE_PRIVATE_INVITE_CODE"
